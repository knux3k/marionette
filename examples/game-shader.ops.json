        "fov_y_degrees": 50.0,
        "near": 0.1
       }
      }
     },
     "LookAt": {
      "target": {
       "x": 0,
       "y": 0.6,
       "z": 0
      },
      "up": {
       "x": 0,
       "y": 1,
       "z": 0
      }
     },
     "Transform": {
      "translation": {
       "x": 3.5,
       "y": 3.2,
       "z": 7.5
      },
      "rotation": {
       "x": 0,
       "y": 0,
       "z": 0,
       "w": 1
      },
      "scale": {
       "x": 1,
       "y": 1,
       "z": 1
      }
     }
    }
   }
  },
  {
