       "y": -0.8,
       "z": -0.4
      },
      "illuminance": 1.4
     }
    }
   }
  },
  {
   "op": "entity_create",
   "input": {
    "scene": "examples/game-shader.scene.json",
    "name": "tiled floor",
    "components": {
     "Model": {
      "asset": "primitive:plane"
     },
     "ShaderMaterial": {
      "shader": "shaders/checker-tint.wgsl",
