{
  "actions": {
    "autoplay": {
      "bindings": [
        {
          "input": "key:F1",
          "scale": 1.0
        }
      ]
    },
    "jump": {
      "bindings": [
        {
          "input": "key:Space",
          "scale": 1.0
        },
        {
          "input": "key:KeyW",
          "scale": 1.0
        },
        {
          "input": "key:ArrowUp",
          "scale": 1.0
        },
        {
          "input": "pad:South",
          "scale": 1.0
        }
      ]
    },
    "move_x": {
      "bindings": [
        {
          "input": "key:KeyD",
          "scale": 1.0
        },
        {
          "input": "key:KeyA",
          "scale": -1.0
        },
        {
          "input": "key:ArrowRight",
          "scale": 1.0
        },
        {
          "input": "key:ArrowLeft",
          "scale": -1.0
        },
        {
          "input": "axis:LeftStickX",
          "scale": 1.0
        }
      ]
    },
    "restart": {
      "bindings": [
        {
          "input": "key:KeyR",
          "scale": 1.0
        },
        {
          "input": "pad:Start",
          "scale": 1.0
        }
      ]
    }
  },
  "format": "marionette.input-map",
  "version": 1
}
