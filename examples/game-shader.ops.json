      },
      "scale": {
       "x": 1.0,
       "y": 1.8,
       "z": 1.0
      }
     }
    }
   }
  },
  {
   "op": "scene_validate",
   "input": {
    "scene": "examples/game-shader.scene.json"
   }
  }
 ]
}