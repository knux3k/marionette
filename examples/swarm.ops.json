       "x": 0.0,
       "y": 0.0,
       "z": 0.0,
       "w": 1.0
      },
      "scale": {
       "x": 30.0,
       "y": 1.0,
       "z": 30.0
      }
     }
    }
   }
  },
  {
   "op": "entity_create",
   "input": {
    "scene": "examples/swarm.scene.json",
    "name": "swarm",
    "components": {
     "Transform": {
      "translation": {
       "x": 0.0,
       "y": 0.0,
       "z": 0.0
      },
      "rotation": {
       "x": 0.0,
       "y": 0.0,
       "z": 0.0,
       "w": 1.0
      },
      "scale": {
       "x": 1,
       "y": 1,
       "z": 1
