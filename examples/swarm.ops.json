       "z": -0.35
      },
      "illuminance": 1.0
     }
    }
   }
  },
  {
   "op": "entity_create",
   "input": {
    "scene": "examples/swarm.scene.json",
    "name": "ground",
    "components": {
     "Model": {
      "asset": "primitive:plane"
     },
     "Material": {
      "base_color": {
       "r": 0.16,
       "g": 0.17,
       "b": 0.2,
       "a": 1.0
      },
      "metallic": 0.0,
      "roughness": 0.9
