{
  "format": "marionette.input-map",
  "version": 1,
  "actions": {
    "move_x": {
      "bindings": [
        {
          "input": "key:KeyD",
          "scale": 1
        },
        {
          "input": "key:KeyA",
          "scale": -1
        },
        {
          "input": "axis:LeftStickX",
          "scale": 1
        }
      ]
    },
    "move_forward": {
      "bindings": [
        {
          "input": "key:KeyW",
          "scale": 1
        },
        {
          "input": "key:KeyS",
          "scale": -1
        },
        {
          "input": "axis:LeftStickY",
          "scale": 1
        }
      ]
    },
    "jump": {
      "bindings": [
        {
          "input": "key:Space",
          "scale": 1
        },
        {
          "input": "pad:South",
          "scale": 1
        }
      ]
    },
    "fire": {
      "bindings": [
        {
          "input": "mouse:Left",
          "scale": 1
        },
        {
          "input": "key:KeyF",
          "scale": 1
        },
        {
          "input": "pad:RightTrigger",
          "scale": 1
        }
      ]
    },
    "look_x": {
      "bindings": [
        {
          "input": "axis:MouseX",
          "scale": 1
        }
      ]
    },
    "look_y": {
      "bindings": [
        {
          "input": "axis:MouseY",
          "scale": 1
        }
      ]
    },
    "turn": {
      "bindings": [
        {
          "input": "key:ArrowRight",
          "scale": 1
        },
        {
          "input": "key:ArrowLeft",
          "scale": -1
        },
        {
          "input": "key:KeyE",
          "scale": 1
        },
        {
          "input": "key:KeyQ",
          "scale": -1
        },
        {
          "input": "axis:RightStickX",
          "scale": 1
        }
      ]
    },
    "tilt": {
      "bindings": [
        {
          "input": "key:ArrowUp",
          "scale": 1
        },
        {
          "input": "key:ArrowDown",
          "scale": -1
        },
        {
          "input": "axis:RightStickY",
          "scale": 1
        }
      ]
    }
  }
}
