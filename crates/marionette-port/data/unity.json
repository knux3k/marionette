{
  "engine": "unity",
  "language": "C#",
  "bases": [
    {
      "name": "MonoBehaviour",
      "role": "behaviour",
      "marionette": "A TypeScript script on the entity (`Script { path }` component).",
      "status": "script"
    },
    {
      "name": "NetworkBehaviour",
      "role": "behaviour",
      "marionette": "A TypeScript script; networking has no equivalent.",
      "status": "gap"
    },
    {
      "name": "ScriptableObject",
      "role": "data",
      "marionette": "A JSON data file loaded by the scene, or constants in the script.",
      "status": "rewrite",
      "note": "Marionette has no asset-object type yet; keep the values as script constants or entity components."
    },
    {
      "name": "StateMachineBehaviour",
      "role": "other",
      "marionette": "No animator state machines.",
      "status": "gap"
    },
    {
      "name": "Editor",
      "role": "editor",
      "marionette": "Editor code is not ported: Marionette is edited through operations (`marionette ops`).",
      "status": "gap"
    },
    {
      "name": "EditorWindow",
      "role": "editor",
      "marionette": "Editor code is not ported: Marionette is edited through operations (`marionette ops`).",
      "status": "gap"
    }
  ],
  "hooks": [
    {
      "name": "Awake",
      "marionette": "start",
      "status": "script",
      "note": "Marionette has one start hook, called on the first tick the entity runs. Put Awake code first, then Start code."
    },
    {
      "name": "OnEnable",
      "marionette": "start",
      "status": "script",
      "note": "No enable/disable; runs once with start."
    },
    {
      "name": "Start",
      "marionette": "start",
      "status": "script"
    },
    {
      "name": "Update",
      "marionette": "update",
      "status": "script",
      "note": "Marionette only has fixed ticks (default 60 per second). Update and FixedUpdate both become update; Time.deltaTime is engine.dt."
    },
    {
      "name": "FixedUpdate",
      "marionette": "update",
      "status": "script",
      "note": "Put FixedUpdate code before Update code in update (Unity's order within a frame)."
    },
    {
      "name": "LateUpdate",
      "marionette": "update",
      "status": "rewrite",
      "note": "No hook after physics. Put the code at the end of update; cameras usually work better with the LookAt or Follow component."
    },
    {
      "name": "OnCollisionEnter",
      "marionette": "onCollisionEnter",
      "status": "script",
      "note": "Receives the other Entity, not a Collision. Contact points and impulse are not available."
    },
    {
      "name": "OnCollisionEnter2D",
      "marionette": "onCollisionEnter",
      "status": "script",
      "note": "Same hook in 2D."
    },
    {
      "name": "OnCollisionExit",
      "marionette": "onCollisionExit",
      "status": "script"
    },
    {
      "name": "OnCollisionExit2D",
      "marionette": "onCollisionExit",
      "status": "script"
    },
    {
      "name": "OnTriggerEnter",
      "marionette": "onCollisionEnter",
      "status": "script",
      "note": "Give the trigger a Collider with sensor: true; its overlaps arrive as onCollisionEnter. No separate trigger hook yet."
    },
    {
      "name": "OnTriggerEnter2D",
      "marionette": "onCollisionEnter",
      "status": "script",
      "note": "Collider with sensor: true; overlaps arrive as onCollisionEnter."
    },
    {
      "name": "OnTriggerExit",
      "marionette": "onCollisionExit",
      "status": "script",
      "note": "Collider with sensor: true."
    },
    {
      "name": "OnTriggerExit2D",
      "marionette": "onCollisionExit",
      "status": "script",
      "note": "Collider with sensor: true."
    },
    {
      "name": "OnCollisionStay",
      "marionette": "update",
      "status": "rewrite",
      "note": "Set a flag in self.state on enter, clear it on exit, act on it in update."
    },
    {
      "name": "OnCollisionStay2D",
      "marionette": "update",
      "status": "rewrite",
      "note": "Flag in self.state between enter and exit."
    },
    {
      "name": "OnTriggerStay",
      "marionette": "update",
      "status": "rewrite",
      "note": "Flag in self.state between enter and exit."
    },
    {
      "name": "OnTriggerStay2D",
      "marionette": "update",
      "status": "rewrite",
      "note": "Flag in self.state between enter and exit."
    },
    {
      "name": "OnDestroy",
      "marionette": "",
      "status": "gap",
      "note": "No despawn hook yet."
    },
    {
      "name": "OnDisable",
      "marionette": "",
      "status": "gap",
      "note": "No enable/disable."
    },
    {
      "name": "OnGUI",
      "marionette": "UiNode + UiText / UiRect / UiButton components",
      "status": "rewrite",
      "note": "Immediate-mode GUI becomes UI entities; update their UiText from the script."
    },
    {
      "name": "OnDrawGizmos",
      "marionette": "",
      "status": "gap",
      "note": "Editor-only drawing; drop it."
    },
    {
      "name": "OnValidate",
      "marionette": "",
      "status": "gap",
      "note": "Editor-only; scene validation is `marionette op scene_validate`."
    },
    {
      "name": "Reset",
      "marionette": "",
      "status": "gap",
      "note": "Editor-only; drop it."
    },
    {
      "name": "OnApplicationQuit",
      "marionette": "",
      "status": "gap"
    },
    {
      "name": "OnMouseDown",
      "marionette": "UiButton (screen UI) or engine.justPressed + observe raycast",
      "status": "rewrite"
    },
    {
      "name": "OnBecameVisible",
      "marionette": "",
      "status": "gap"
    }
