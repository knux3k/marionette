  "bases": [
    {
      "name": "AActor",
      "role": "actor",
      "marionette": "An entity with a TypeScript script (`Script { path }` component).",
      "status": "script"
    },
    {
      "name": "APawn",
      "role": "actor",
      "marionette": "An entity with a script; possession is not a concept, input actions are global.",
      "status": "script"
    },
    {
      "name": "ACharacter",
      "role": "actor",
      "marionette": "An entity with CharacterController + Collider (Capsule) + a script.",
      "status": "script",
      "note": "UCharacterMovementComponent maps to CharacterController (walk, jump, slopes, pushing)."
    },
    {
      "name": "AGameModeBase",
