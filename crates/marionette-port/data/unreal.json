  "hooks": [
    {
      "name": "BeginPlay",
      "marionette": "start",
      "status": "script",
      "note": "Drop the Super::BeginPlay() call."
    },
    {
      "name": "PostInitializeComponents",
      "marionette": "start",
      "status": "script"
    },
    {
      "name": "OnConstruction",
      "marionette": "the entity's components in the scene file",
      "status": "rewrite",
      "note": "Construction scripts become data written through operations."
    },
    {
      "name": "Tick",
      "marionette": "update",
      "status": "script",
      "note": "DeltaTime is engine.dt (fixed step). PrimaryActorTick.bCanEverTick is not needed: update is optional."
    },
    {
      "name": "TickComponent",
      "marionette": "update",
      "status": "script"
    },
    {
      "name": "NotifyHit",
      "marionette": "onCollisionEnter",
      "status": "script",
      "note": "Receives the other Entity; no hit result."
    },
    {
      "name": "ReceiveHit",
      "marionette": "onCollisionEnter",
      "status": "script"
    },
    {
      "name": "NotifyActorBeginOverlap",
      "marionette": "onTriggerEnter",
      "status": "script",
      "note": "The overlapping collider is a sensor (Collider.sensor: true)."
    },
    {
      "name": "NotifyActorEndOverlap",
      "marionette": "onTriggerExit",
      "status": "script",
      "note": "Collider.sensor: true."
    },
    {
      "name": "EndPlay",
      "marionette": "onDestroy",
      "status": "script",
      "note": "Runs when engine.destroy removes the entity (end of the script stage), not when the run ends."
    },
    {
      "name": "Destroyed",
      "marionette": "onDestroy",
      "status": "script",
      "note": "Runs when engine.destroy removes the entity (end of the script stage), not when the run ends."
    },
    {
      "name": "BeginDestroy",
      "marionette": "onDestroy",
      "status": "script",
      "note": "Garbage-collection hook; put cleanup in onDestroy."
    },
    {
      "name": "SetupPlayerInputComponent",
      "marionette": "the action map file (*.actions.json)",
      "status": "rewrite",
      "note": "Each BindAxis / BindAction / Enhanced Input action becomes an action in the map; the bound function's body moves into update, reading engine.action / engine.justPressed."
    },
    {
      "name": "PossessedBy",
      "marionette": "",
      "status": "gap"
    },
    {
      "name": "Landed",
      "marionette": "update, when CharacterState.grounded turns true",
      "status": "rewrite"
    },
    {
      "name": "OnJumped",
      "marionette": "AudioSource trigger OnJump, or justPressed(jump) && grounded in update",
      "status": "rewrite"
    },
    {
      "name": "NativeConstruct",
      "marionette": "start",
      "status": "rewrite"
    },
    {
      "name": "NativeTick",
      "marionette": "update",
      "status": "rewrite"
    },
    {
      "name": "ReceiveBeginPlay",
      "marionette": "start",
      "status": "script",
      "note": "Blueprint Event BeginPlay."
    },
    {
      "name": "ReceiveTick",
      "marionette": "update",
      "status": "script",
      "note": "Blueprint Event Tick; Delta Seconds is engine.dt."
    },
    {
      "name": "ReceiveActorBeginOverlap",
      "marionette": "onTriggerEnter",
      "status": "script",
      "note": "Blueprint overlap event; Collider.sensor: true."
    },
    {
      "name": "ReceiveActorEndOverlap",
      "marionette": "onTriggerExit",
      "status": "script",
      "note": "Collider.sensor: true."
    },
    {
      "name": "ReceiveEndPlay",
      "marionette": "onDestroy",
      "status": "script",
      "note": "Runs when engine.destroy removes the entity (end of the script stage), not when the run ends."
    },
    {
      "name": "ReceiveDestroyed",
      "marionette": "onDestroy",
      "status": "script",
      "note": "Runs when engine.destroy removes the entity (end of the script stage), not when the run ends."
    }
