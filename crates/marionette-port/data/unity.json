    {
      "name": "MeshFilter",
      "marionette": "Model",
      "status": "ready"
    },
    {
      "name": "SkinnedMeshRenderer",
      "marionette": "Model",
      "status": "gap",
      "note": "Skinning and skeletal animation are not supported yet."
    },
    {
      "name": "SpriteRenderer",
      "marionette": "Sprite (+ SpriteRegion for atlas cells)",
      "status": "ready",
      "note": "sortingOrder -> layer; color -> color."
    },
    {
      "name": "AudioSource",
      "marionette": "AudioSource",
      "status": "ready",
      "note": "playOnAwake -> trigger OnStart; loop -> looping. Play() from code: use trigger OnAction or OnCollision, or engine.emit; arbitrary Play() is a gap."
    },
    {
      "name": "AudioListener",
