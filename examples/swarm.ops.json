       "x": 0.0,
       "y": 1.0,
       "z": 0.0
      }
     },
     "Transform": {
      "translation": {
       "x": 0.0,
       "y": 4.5,
       "z": 10.0
      },
      "rotation": {
       "x": 0.0,
       "y": 0.0,
       "z": 0.0,
       "w": 1.0
      },
      "scale": {
       "x": 1,
       "y": 1,
       "z": 1
      }
