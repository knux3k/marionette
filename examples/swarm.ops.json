        "values": {
         "F32": []
        }
       },
       {
        "name": "pz",
        "values": {
         "F32": []
        }
       },
       {
        "name": "vx",
        "values": {
         "F32": []
        }
       },
       {
        "name": "vy",
        "values": {
         "F32": []
        }
       },
       {
        "name": "vz",
        "values": {
         "F32": []
        }
       }
      ]
     },
     "JobSchedule": {
      "steps": [
       {
        "path": "jobs/swarm.job.ts",
        "function": "step",
        "args": [
         "px",
         "py",
         "pz",
         "vx",
         "vy",
         "vz",
         "dt",
         "tick",
         "chunk_start"
        ],
        "chunk": 1024
       }
      ]
     },
     "JobDraw": {
      "asset": "primitive:cube",
      "material": {
       "base_color": {
        "r": 1.0,
        "g": 0.55,
        "b": 0.2,
        "a": 1.0
       },
       "metallic": 0.0,
       "roughness": 0.4
      },
      "x": "px",
      "y": "py",
      "z": "pz",
      "scale": 0.07
     },
     "Script": {
      "path": "scripts/swarm.ts"
     }
    }
   }
