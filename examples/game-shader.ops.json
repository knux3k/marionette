      "metallic": 0.0,
      "roughness": 0.4
     },
     "Transform": {
      "translation": {
       "x": -1.0,
       "y": 0.75,
       "z": 0.5
      },
      "rotation": {
       "x": 0,
       "y": 0,
       "z": 0,
       "w": 1
      },
      "scale": {
       "x": 1.5,
       "y": 1.5,
       "z": 1.5
      }
     }
    }
   }
  },
  {
   "op": "entity_create",
   "input": {
    "scene": "examples/game-shader.scene.json",
