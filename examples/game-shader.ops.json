{
 "format": "marionette.ops",
 "version": 1,
 "ops": [
  {
   "op": "scene_create",
   "input": {
    "scene": "examples/game-shader.scene.json"
   }
  },
  {
   "op": "resource_set",
   "input": {
    "scene": "examples/game-shader.scene.json",
    "resource": "SkyLight",
    "value": {
     "sky": {
      "r": 0.25,
      "g": 0.32,
      "b": 0.5,
      "a": 1.0
     },
     "ground": {
      "r": 0.1,
      "g": 0.09,
      "b": 0.08,
      "a": 1.0
     },
     "intensity": 0.4
    }
   }
  },
  {
   "op": "resource_set",
   "input": {
    "scene": "examples/game-shader.scene.json",
    "resource": "Shadows",
    "value": {
     "distance": 12.0,
     "resolution": 2048,
     "softness": 1.5
    }
   }
  },
  {
   "op": "resource_set",
   "input": {
    "scene": "examples/game-shader.scene.json",
    "resource": "ToneMapping",
    "value": {
     "exposure": 1.2
    }
   }
  },
  {
