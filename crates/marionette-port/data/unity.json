  "components": [
    {
      "name": "Transform",
      "marionette": "Transform",
      "status": "ready",
      "note": "translation / rotation (quaternion x,y,z,w) / scale. No parent-child hierarchy: world space only."
    },
    {
      "name": "RectTransform",
      "marionette": "UiNode",
      "status": "ready",
      "note": "anchor + offset (pixels, +y down) + size."
    },
    {
      "name": "Rigidbody",
      "marionette": "RigidBody",
      "status": "ready",
      "note": "kind Dynamic (isKinematic=false) or Kinematic; drag -> linear_damping, angularDrag -> angular_damping, freezeRotation -> lock_rotations, useGravity=false -> gravity_scale 0. Needs a Collider."
    },
    {
      "name": "Rigidbody2D",
      "marionette": "RigidBody",
      "status": "ready",
      "note": "2D is chosen per scene; same component."
    },
    {
      "name": "BoxCollider",
      "marionette": "Collider { shape: Cuboid }",
      "status": "ready",
      "note": "half_extents = size / 2. isTrigger -> sensor: true. PhysicMaterial -> friction / restitution."
    },
    {
      "name": "BoxCollider2D",
      "marionette": "Collider { shape: Cuboid }",
      "status": "ready",
      "note": "half_extents = size / 2 (z ignored)."
