    {
      "name": "CapsuleCollider2D",
      "marionette": "Collider { shape: Capsule }",
      "status": "ready"
    },
    {
      "name": "MeshCollider",
      "marionette": "Collider { shape: TriMesh } (or ConvexHull when convex)",
      "status": "ready"
    },
    {
      "name": "CharacterController",
      "marionette": "CharacterController + CharacterState",
      "status": "ready",
      "note": "Driven by input actions (move_x, move_forward, jump) instead of Move(); a fully script-driven Move() is a gap."
    },
    {
      "name": "Camera",
      "marionette": "Camera",
      "status": "ready",
      "note": "fieldOfView -> Perspective.fov_y_degrees; orthographicSize * 2 -> Orthographic.height; backgroundColor -> clear_color."
    },
    {
      "name": "Light",
      "marionette": "DirectionalLight",
      "status": "ready",
      "note": "Directional lights only; point and spot lights are a gap."
    },
    {
      "name": "MeshRenderer",
      "marionette": "Model + Material",
      "status": "ready",
      "note": "Model.asset is a glTF file (import FBX models through library_import first)."
