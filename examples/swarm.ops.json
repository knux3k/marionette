{
 "format": "marionette.ops",
 "version": 1,
 "ops": [
  {
   "op": "scene_create",
   "input": {
    "scene": "examples/swarm.scene.json"
   }
  },
  {
   "op": "resource_set",
   "input": {
    "scene": "examples/swarm.scene.json",
    "resource": "SkyLight",
    "value": {
     "sky": {
      "r": 0.45,
      "g": 0.55,
      "b": 0.9,
      "a": 1.0
     },
     "ground": {
      "r": 0.2,
      "g": 0.16,
      "b": 0.14,
      "a": 1.0
     },
     "intensity": 0.3
    }
   }
  },
  {
   "op": "resource_set",
   "input": {
    "scene": "examples/swarm.scene.json",
    "resource": "Shadows",
    "value": {
     "distance": 12.0,
     "resolution": 2048,
     "softness": 1.5
    }
   }
  },
  {
   "op": "resource_set",
   "input": {
    "scene": "examples/swarm.scene.json",
    "resource": "ToneMapping",
    "value": {
     "exposure": 1.1
    }
   }
  },
  {
